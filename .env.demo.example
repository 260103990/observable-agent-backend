# Local-only demo. Separate from the existing application .env.
# Replace with a URL-safe password (letters/digits/_/-); do not use URL delimiters.
DEMO_DB_PASSWORD=demo_local_only_change_me
DEMO_API_PORT=18080
# Runtime secret only: never place a real key in this tracked example.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
WEB_SEARCH_ENABLED=false
WEB_SEARCH_CACHE_ENABLED=false
# Docker Desktop resolves this to the host; Ollama and its model remain on Windows.
DEMO_OLLAMA_BASE_URL=http://host.docker.internal:11434
