OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_GENERATE_URL=http://127.0.0.1:11434/api/generate
OLLAMA_CHAT_URL=http://127.0.0.1:11434/api/chat
OLLAMA_TIMEOUT_SECONDS=120

# Optional PostgreSQL TraceStore. Keep commented for default in-memory mode.
# Set DATABASE_URL in the environment of the process that starts the app.
# DATABASE_URL=postgresql://agent:agent_dev_password@127.0.0.1:55433/observable_agent

# Database tests read TEST_DATABASE_URL from the process environment, not this file.
# Set it in a separate test terminal; see README.md.

# RAG embedding is independent from the chat/tool-calling model.
# Install explicitly: ollama pull qwen3-embedding:0.6b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_EMBED_URL=http://127.0.0.1:11434/api/embed
OLLAMA_EMBEDDING_DIMENSIONS=1024
OLLAMA_EMBEDDING_BATCH_SIZE=16
OLLAMA_EMBEDDING_TIMEOUT_SECONDS=120
EMBEDDING_QUERY_INSTRUCTION="Given a question about a scientific paper, retrieve relevant passages that answer the question."

# Optional DeepSeek answer generation. Put a real key only in local .env / environment.
# DEEPSEEK_API_KEY=your-local-key
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_CHAT_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_TIMEOUT_SECONDS=120
DEEPSEEK_MAX_TOKENS=2048
RAG_MAX_EVIDENCE_CHARS=12000
RAG_MAX_EVIDENCE_ITEMS=10

# Opt in only with an initialized PostgreSQL/pgvector database.
RAG_ENABLED=false
RAG_STORAGE_DIR=data/papers
RAG_MAX_FILE_BYTES=20971520
RAG_MAX_PAGES=100
RAG_MAX_TEXT_CHARS=1000000
RAG_MAX_CHUNKS=2000
RAG_MAX_CONCURRENCY=2
RAG_QUEUE_TIMEOUT_SECONDS=5
RAG_CHUNK_SIZE_CHARS=1200
RAG_OVERLAP_CHARS=150

# V2 bounded loop. Server-owned limits; no migration or background workers.
AGENT_LOOP_MAX_ROUNDS=5
AGENT_LOOP_MAX_TOOL_CALLS=8
AGENT_LOOP_MAX_CALLS_PER_TURN=4
AGENT_LOOP_MODEL_TIMEOUT_SECONDS=120
AGENT_LOOP_TOOL_TIMEOUT_SECONDS=60
AGENT_LOOP_RUN_TIMEOUT_SECONDS=240
AGENT_LOOP_TRACE_TIMEOUT_SECONDS=5
AGENT_LOOP_MAX_HISTORY_CHARS=64000
AGENT_LOOP_MAX_TOOL_RESULT_CHARS=32000

# V2 Web Search: both this server flag and request enable_web_search=true are needed.
# Uses the existing DEEPSEEK_API_KEY. Search caching is configured below; no full-page Fetch.
WEB_SEARCH_ENABLED=false
WEB_SEARCH_TIMEOUT_SECONDS=30
WEB_SEARCH_MAX_RESPONSE_BYTES=262144
WEB_SEARCH_MAX_EVIDENCE_ITEMS=10
WEB_SEARCH_MAX_EVIDENCE_CHARS=12000

# Final answer repair uses existing round/time/history budgets; 0 disables it.
AGENT_LOOP_MAX_FINAL_REPAIRS=1

# V3.1 process-local exact Search-result cache; default off, no Redis dependency.
WEB_SEARCH_CACHE_ENABLED=false
WEB_SEARCH_CACHE_TTL_SECONDS=300
WEB_SEARCH_CACHE_MAX_ENTRIES=128
WEB_SEARCH_CACHE_MAX_BYTES=8388608
WEB_SEARCH_CACHE_MAX_ENTRY_BYTES=262144
WEB_SEARCH_CACHE_TIMEOUT_SECONDS=0.05

# Coalesce identical concurrent cold Search requests within this process.
# Effective only when WEB_SEARCH_CACHE_ENABLED=true.
WEB_SEARCH_CACHE_COALESCE_ENABLED=true
WEB_SEARCH_CACHE_MAX_INFLIGHT=64
WEB_SEARCH_CACHE_MAX_WAITERS=32

# Optional retrieval fusion; original exact vector ordering remains the default.
RAG_RETRIEVAL_STRATEGY=vector

# Experimental answer-focus guidance; not a semantic validator and not promoted by quality tests.
ANSWER_SCOPE_POLICY_ENABLED=false
